# Settings template for STS LMS. Copy this file to .env and fill in the values. .env is git-ignored, so keys never reach GitHub; keep this file free of real keys.

# Development: true. On the server: remove it or set false.
DJANGO_DEBUG=true
# Required everywhere (each computer and server its own). Any long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Public address of the site; links in emails use it. e.g. https://lms.stsgroupbd.com
SITE_URL=
# Extra host names, comma-separated (the SITE_URL host is added automatically)
DJANGO_ALLOWED_HOSTS=

# MySQL 8.4+. Leave DB_NAME empty to use the local SQLite file (db.sqlite3) instead.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Claude API key from your workspace: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=
# Only if the key isn't scoped to a workspace (starts sk-ant-usr-): the wrkspc_... ID from Settings -> Workspaces
ANTHROPIC_WORKSPACE_ID=

# Model used for practice questions and confidential final papers (optional)
QUESTION_GENERATION_MODEL=claude-opus-5-5

# Which AI writes questions: anthropic (default, uses ANTHROPIC_API_KEY) or gemini (uses GEMINI_API_KEY)
AI_PROVIDER=
# Gemini API key from Google AI Studio: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Models for practice questions / final papers (optional). Empty = provider default:
# anthropic -> QUESTION_GENERATION_MODEL for both; gemini -> gemini-3.8-flash / gemini-4-argon
AI_MODEL=
AI_FINAL_MODEL=
# true only once the Google project has billing on: final papers are refused on Gemini's free tier.
# Accepts only true or 1 (any other value, including yes/on, means off).
GEMINI_PAID_TIER=

# Outgoing email (welcome emails, password resets). Leave EMAIL_HOST empty to print emails in the terminal.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=you@gmail.com,
# EMAIL_HOST_PASSWORD=<a Google "App password", not your normal password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=STS Pulse <no-reply@stsgroupbd.com>

# Make.com: events (new user, welcome email, leave approved) are sent to the webhook URL if set, otherwise to the mailhook.
# Once set, all emails (welcome, password reset, reminders) go out through Make instead of EMAIL_*.
# Webhook URL from a "Custom webhook" trigger, e.g. https://hook.eu1.make.com/abc123...
MAKE_WEBHOOK_URL=
# Mailhook address from a "Custom mailhook" trigger (needs the EMAIL_* settings above to actually send)
MAKE_MAILHOOK_ADDRESS=
